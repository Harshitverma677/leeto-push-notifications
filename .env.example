# Firebase Admin SDK service account JSON as a single-line JSON string.
# Never commit the real value. Configure it in your hosting provider's secret settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID
FIREBASE_PROJECT_ID=leetrack-5284d

# Polling interval in minutes. Start conservatively to avoid LeetCode rate limits.
POLL_INTERVAL_MINUTES=2

# Maximum number of member profiles processed per poll.
POLL_MAX_CONCURRENCY=3

# Lookback window used when querying recent submissions.
MAX_SUBMISSION_LOOKBACK=20

# HTTP server port for health checks / hosting platforms.
PORT=3000
NODE_ENV=development
