# Use exactly one credential option. Keep the JSON key private and never commit it.
# Option A: path to the downloaded service-account JSON file (relative to this project folder)
FIREBASE_SERVICE_ACCOUNT_PATH=./leetrack-5284d-firebase-adminsdk.json
# Option B: complete service-account JSON on one line (leave PATH empty if using this)
# FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=leetrack-5284d

# Generate with: openssl rand -hex 32
POLL_SECRET=

POLL_INTERVAL_MINUTES=2
POLL_MAX_CONCURRENCY=3
MAX_SUBMISSION_LOOKBACK=20

PORT=3000
NODE_ENV=development
