# Firebase Admin SDK service account JSON as a single-line JSON string.
# Never commit the real value. Configure it in your hosting provider's secret settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID
FIREBASE_PROJECT_ID=leetrack-5284d

# Generate a random secret with: openssl rand -hex 32
POLL_SECRET=

# Polling interval in minutes. Configure your scheduler to match this value.
POLL_INTERVAL_MINUTES=2
POLL_MAX_CONCURRENCY=3
MAX_SUBMISSION_LOOKBACK=20

PORT=3000
NODE_ENV=development
